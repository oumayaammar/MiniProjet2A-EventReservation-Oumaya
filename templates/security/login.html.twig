{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow p-4 mt-5">
            <h3 class="text-center mb-4">🔐 Connexion</h3>
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans({}, 'security') }}</div>
            {% endif %}
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nom d'utilisateur</label>
                    <input type="text" name="_username" value="{{ last_username }}" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mot de passe</label>
                    <input type="password" name="_password" class="form-control" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-primary w-100">Se connecter</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}