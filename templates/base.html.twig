<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}EventReservation{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">🎫 EventApp</a>
        <div class="ms-auto">
            {% if app.user %}
                <span class="text-white me-3">{{ app.user.username }}</span>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Connexion</a>
            {% endif %}
        </div>
    </div>
</nav>
<div class="container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</div>
</body>
</html>