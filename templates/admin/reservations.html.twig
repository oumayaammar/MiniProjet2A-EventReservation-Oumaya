{% extends 'base.html.twig' %}
{% block title %}Réservations - {{ event.title }}{% endblock %}
{% block body %}
<h1>📋 Réservations pour : {{ event.title }}</h1>
<a href="{{ path('admin_dashboard') }}" class="btn btn-secondary mb-3">← Retour</a>
<table class="table table-bordered shadow">
    <thead class="table-dark">
        <tr><th>Nom</th><th>Email</th><th>Téléphone</th><th>Date réservation</th></tr>
    </thead>
    <tbody>
    {% for r in reservations %}
        <tr>
            <td>{{ r.name }}</td>
            <td>{{ r.email }}</td>
            <td>{{ r.phone }}</td>
            <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
        </tr>
    {% else %}
        <tr><td colspan="4" class="text-center">Aucune réservation.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}