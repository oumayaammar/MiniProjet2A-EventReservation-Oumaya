{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🛠️ Tableau de bord</h1>
    <a href="{{ path('admin_event_new') }}" class="btn btn-success">+ Nouvel événement</a>
</div>
<table class="table table-striped table-bordered shadow">
    <thead class="table-dark">
        <tr><th>Titre</th><th>Date</th><th>Lieu</th><th>Places</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for event in events %}
        <tr>
            <td>{{ event.title }}</td>
            <td>{{ event.date|date('d/m/Y') }}</td>
            <td>{{ event.location }}</td>
            <td>{{ event.seats }}</td>
            <td>
                <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-warning btn-sm">✏️</a>
                <a href="{{ path('admin_event_reservations', {id: event.id}) }}" class="btn btn-info btn-sm">📋</a>
                <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete'~event.id) }}">
                    <button onclick="return confirm('Supprimer ?')" class="btn btn-danger btn-sm">🗑️</button>
                </form>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}