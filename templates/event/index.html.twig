{% extends 'base.html.twig' %}
{% block title %}Événements{% endblock %}
{% block body %}
<h1 class="mb-4">🗓️ Événements disponibles</h1>
<div class="row">
    {% for event in events %}
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            {% if event.image %}
                <img src="{{ event.image }}" class="card-img-top" style="height:200px;object-fit:cover">
            {% endif %}
            <div class="card-body">
                <h5 class="card-title">{{ event.title }}</h5>
                <p class="text-muted">📍 {{ event.location }} | 📅 {{ event.date|date('d/m/Y H:i') }}</p>
                <p class="card-text">{{ event.description|slice(0, 100) }}...</p>
                <span class="badge bg-info">{{ event.seats }} places</span>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn-primary w-100">Voir & Réserver</a>
            </div>
        </div>
    </div>
    {% else %}
    <p>Aucun événement disponible.</p>
    {% endfor %}
</div>
{% endblock %}